# Environment Variables Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES

# Application Configuration
APP_ENV=production
APP_VERSION=blue-v1
DEPLOYMENT_COLOR=blue
SERVICE_NAME=healthcare-api

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Kubernetes Configuration
NAMESPACE=healthcare-devops
# Optional: set this if your local tooling needs an explicit kubeconfig path.
# Windows example: C:\Users\<you>\.kube\config
# Linux/macOS example: /home/<you>/.kube/config

# Docker Registry Configuration
DOCKERHUB_USERNAME=kulharshit21
DOCKERHUB_REGISTRY=docker.io
DOCKER_IMAGE_TAG=latest

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=admin
JENKINS_TOKEN=not-configured-local-demo

# Kubernetes Secrets (Base64 encoded in K8s)
# DO NOT USE REAL PASSWORDS - These are demo values only
JWT_SECRET=demo-secret-change-me-in-production
DATABASE_PASSWORD=demo-password-change-me-in-production

# Trivy Scanner Configuration
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Minikube Configuration
MINIKUBE_DRIVER=docker
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8192
